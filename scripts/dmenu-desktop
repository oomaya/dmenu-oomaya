#!/bin/sh
# dmenu-desktop — Centered Tokyo Night Application Launcher
set -eu

PROMPT="  Apps >"

# Determine terminal emulator honoring user's preferences
TERMINAL=${TERMINAL:-kitty}
[ -x "$(command -v "$TERMINAL" 2>/dev/null)" ] || TERMINAL=alacritty
[ -x "$(command -v "$TERMINAL" 2>/dev/null)" ] || TERMINAL=ghostty
[ -x "$(command -v "$TERMINAL" 2>/dev/null)" ] || TERMINAL=xterm

# Parse XDG desktop files with sub-millisecond awk
selected=$(awk -F= '
BEGIN { name=""; exec=""; nodisplay=0; term=0; icon="" }
/^\[Desktop Entry\]/ { in_entry=1; next }
/^\[/ { in_entry=0 }
in_entry && /^Name=/ && !name { name=substr($0, 6) }
in_entry && /^Exec=/ && !exec { exec=substr($0, 6) }
in_entry && /^NoDisplay=true/ { nodisplay=1 }
in_entry && /^Terminal=true/ { term=1 }
ENDFILE {
    if (in_entry && name != "" && exec != "" && !nodisplay) {
        gsub(/%[a-zA-Z]/, "", exec)
        sub(/^[ \t]+|[ \t]+$/, "", exec)
        
        # Categorize glyph
        lname = tolower(name " " exec)
        glyph = " "
        if (lname ~ /(firefox|brave|chrome|chromium|browser|surf|web)/)
            glyph = " "
        else if (lname ~ /(term|kitty|alacritty|ghostty|foot|console)/)
            glyph = " "
        else if (lname ~ /(editor|nvim|vim|code|ide|studio|text)/)
            glyph = " "
        else if (lname ~ /(file|thunar|nautilus|ranger|yazi|fm)/)
            glyph = " "
        else if (lname ~ /(music|audio|player|spotify|mpv|vlc|media)/)
            glyph = " "
        else if (lname ~ /(setting|config|control|display|network|bluetooth)/)
            glyph = " "
        else if (lname ~ /(top|btop|htop|monitor|task|process)/)
            glyph = " "
        else if (lname ~ /(image|photo|gimp|inkscape|view)/)
            glyph = " "

        printf "%s %-32s \t%s\t%s\n", glyph, name, exec, (term ? "term" : "gui")
    }
    name=""; exec=""; nodisplay=0; term=0; in_entry=0
}' /usr/share/applications/*.desktop /usr/local/share/applications/*.desktop "${XDG_DATA_HOME:-$HOME/.local/share}/applications/"*.desktop 2>/dev/null | sort -u -k1,1 | dmenu -p "$PROMPT" -l 10)

[ -n "$selected" ] || exit 0

cmd=$(printf '%s\n' "$selected" | cut -f2)
is_term=$(printf '%s\n' "$selected" | cut -f3)

if [ "$is_term" = "term" ]; then
    nohup "$TERMINAL" -e $cmd >/dev/null 2>&1 &
else
    nohup /bin/sh -c "$cmd" >/dev/null 2>&1 &
fi
