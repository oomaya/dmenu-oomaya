#!/bin/sh
# dmenu-desktop — Centered Tokyo Night Application Launcher
set -eu

PROMPT="  Apps >"

# Determine terminal emulator honoring user's preferences
TERMINAL=${TERMINAL:-kitty}
[ -x "$(command -v "$TERMINAL" 2>/dev/null)" ] || TERMINAL=alacritty
[ -x "$(command -v "$TERMINAL" 2>/dev/null)" ] || TERMINAL=ghostty
[ -x "$(command -v "$TERMINAL" 2>/dev/null)" ] || TERMINAL=xterm

# Parse XDG desktop files with sub-millisecond awk
selected=$(awk -v term_bin="$TERMINAL" -F= '
BEGIN { name=""; exec=""; nodisplay=0; term=0; in_entry=0; in_action=0 }
/^\[Desktop Entry\]/ { in_entry=1; in_action=0; next }
/^\[Desktop Action/ { in_action=1 }
/^\[/ { if (!/^\[Desktop Action/) { in_entry=0; in_action=0 } }
in_entry && !in_action && /^Name=/ && !name { name=substr($0, 6) }
in_entry && !in_action && /^Exec=/ && !exec { exec=substr($0, 6) }
in_entry && !in_action && /^NoDisplay=true/ { nodisplay=1 }
in_entry && !in_action && /^Terminal=true/ { term=1 }
ENDFILE {
    if (name != "" && exec != "" && !nodisplay) {
        gsub(/%[a-zA-Z]/, "", exec)
        sub(/^[ \t]+|[ \t]+$/, "", exec)
        if (term)
            exec = term_bin " -e " exec
        
        # Categorize glyph
        lname = tolower(name " " exec)
        glyph = " "
        if (lname ~ /(firefox|brave|chrome|chromium|browser|surf|web)/)
            glyph = " "
        else if (lname ~ /(term|kitty|alacritty|ghostty|foot|console)/)
            glyph = " "
        else if (lname ~ /(editor|nvim|vim|code|ide|studio|text)/)
            glyph = " "
        else if (lname ~ /(file|thunar|nautilus|ranger|yazi|fm)/)
            glyph = " "
        else if (lname ~ /(music|audio|player|spotify|mpv|vlc|media)/)
            glyph = " "
        else if (lname ~ /(setting|config|control|display|network|bluetooth)/)
            glyph = " "
        else if (lname ~ /(top|btop|htop|monitor|task|process)/)
            glyph = " "
        else if (lname ~ /(image|photo|gimp|inkscape|view)/)
            glyph = " "

        printf "%s  %-32s  │  %s\n", glyph, name, exec
    }
    name=""; exec=""; nodisplay=0; term=0; in_entry=0; in_action=0
}' /usr/share/applications/*.desktop /usr/local/share/applications/*.desktop "${XDG_DATA_HOME:-$HOME/.local/share}/applications/"*.desktop 2>/dev/null | sort -u | dmenu -p "$PROMPT" -l 10)

[ -n "$selected" ] || exit 0

cmd=$(printf '%s\n' "$selected" | sed 's/.*│[ ]*//')
[ -n "$cmd" ] || exit 0

nohup /bin/sh -c "$cmd" >/dev/null 2>&1 &
