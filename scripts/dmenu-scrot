#!/bin/sh
# dmenu-scrot — Centered Tokyo Night Screenshot Utility
set -eu

SCREENSHOT_DIR="${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots"
mkdir -p "$SCREENSHOT_DIR"
TIMESTAMP=$(date +"%Y-%m-%d_%H-%M-%S")
TARGET="$SCREENSHOT_DIR/screenshot_${TIMESTAMP}.png"

PROMPT="  Screenshot >"

choice=$(printf "%s\n" \
	"  Entire Screen" \
	"  Select Area" \
	"  Active Window" | dmenu -p "$PROMPT" -l 3)

[ -n "$choice" ] || exit 0

case "$choice" in
	*"Entire Screen"*)
		sleep 0.2
		maim "$TARGET"
		;;
	*"Select Area"*)
		maim -s "$TARGET"
		;;
	*"Active Window"*)
		sleep 0.2
		active_win=$(xdotool getactivewindow 2>/dev/null || true)
		if [ -n "$active_win" ]; then
			maim -i "$active_win" "$TARGET"
		else
			maim "$TARGET"
		fi
		;;
esac

# Copy to clipboard
if [ -f "$TARGET" ] && command -v xclip >/dev/null 2>&1; then
	xclip -selection clipboard -t image/png -i "$TARGET"
fi
